<?xml version="1.0" encoding="utf-8" ?>
<idea-plugin>
    <id>com.yungyu.leetcode-editor</id>
    <name>leetcode-editor</name>
    <vendor>Wenjun Huang</vendor>
    <version>0.0.0</version>
    <description>Your ultimate plugin for mastering coding challenges directly in Idea platforms!</description>
    <change-notes>Initial release</change-notes>

    <idea-version since-build="262"/>

    <depends>com.intellij.modules.platform</depends>
    <!-- Fork modification: declare the JCEF dependency for IDEA 2026.2 class loading. -->
    <depends>com.intellij.modules.jcef</depends>

    <resource-bundle>messages.PluginBundle</resource-bundle>
    <actions>
        <group id="CodeEpiphany.Actions.LeetCode.ChangeUI"
               class="com.wenjunhuang.codeepiphany.presentation.actions.ModeAction"/>
        <group id="CodeEpiphany.Dojos.Actions.OpenChallengeGroup"
               popup="true"
               class="com.wenjunhuang.codeepiphany.presentation.actions.OpenChallengeGroup"/>
        <group id="CodeEpiphany.Group">
            <action id="CodeEpiphany.Actions.Refresh"
                    class="com.wenjunhuang.codeepiphany.presentation.actions.RefreshAction"
                    icon="AllIcons.Actions.Refresh"/>
            <action id="CodeEpiphany.Actions.Login"
                    class="com.wenjunhuang.codeepiphany.presentation.actions.LoginAction"
                    icon="CodeEpiphanyIcons.LOGIN"/>
            <action id="CodeEpiphany.Actions.Logout"
                    class="com.wenjunhuang.codeepiphany.presentation.actions.LogoutAction"
                    icon="CodeEpiphanyIcons.LOGOUT"/>
            <action id="CodeEpiphany.Actions.Difficulty"
                    class="com.wenjunhuang.codeepiphany.presentation.actions.DifficultyAction"/>
            <action id="CodeEpiphany.Actions.Status"
                    class="com.wenjunhuang.codeepiphany.presentation.actions.StatusAction"/>
            <action id="CodeEpiphany.Actions.Tags"
                    class="com.wenjunhuang.codeepiphany.presentation.actions.TagsAction"/>

            <action id="CodeEpiphany.Actions.EditTestCases"
                    class="com.wenjunhuang.codeepiphany.presentation.editor.TestCasesEditionAction"
                    icon="CodeEpiphanyIcons.EDIT_TESTCASES"/>
            <action id="CodeEpiphany.Actions.RunTest"
                    class="com.wenjunhuang.codeepiphany.presentation.editor.RunTestAction"
                    icon="CodeEpiphanyIcons.RUN"/>
            <action id="CodeEpiphany.Actions.SubmitCode"
                    class="com.wenjunhuang.codeepiphany.presentation.editor.SubmitCodeAction"
                    icon="CodeEpiphanyIcons.SUBMIT"/>
            <action id="CodeEpiphany.Actions.OpenSubmissionCode"
                    class="com.wenjunhuang.codeepiphany.presentation.sidebar.OpenSubmissionCodeAction"/>
            <action id="CodeEpiphany.Actions.ActivateDescriptionView"
                    class="com.wenjunhuang.codeepiphany.presentation.sidebar.ActivateDescriptionAction"
                    icon="CodeEpiphanyIcons.DESCRIPTION"/>
            <action id="CodeEpiphany.Actions.ActivateSolutionsView"
                    class="com.wenjunhuang.codeepiphany.presentation.sidebar.ActivateSolutionsAction"
                    icon="CodeEpiphanyIcons.SOLUTION"/>
            <action id="CodeEpiphany.Actions.ActivateNotesView"
                    class="com.wenjunhuang.codeepiphany.presentation.sidebar.ActivateNotesAction"
                    icon="CodeEpiphanyIcons.NOTE"/>
            <action id="CodeEpiphany.Actions.ActivateSubmissionsView"
                    class="com.wenjunhuang.codeepiphany.presentation.sidebar.ActivateSubmissionsAction"
                    icon="CodeEpiphanyIcons.SUBMISSIONS"/>
            <action id="CodeEpiphany.Actions.SurroundSubmissionRegion"
                    class="com.wenjunhuang.codeepiphany.presentation.editor.SurroundSubmissionRegionAction"
                    icon="CodeEpiphanyIcons.APP_BRACKETS"/>
            <action id="CodeEpiphany.Actions.SolutionSelection"
                    class="com.wenjunhuang.codeepiphany.presentation.editor.SolutionSelectionAction">
            </action>
        </group>
        <group id="CodeEpiphany.LeetCode.Group">
            <action id="CodeEpiphany.Actions.LeetCode.Favorite"
                    class="com.wenjunhuang.codeepiphany.presentation.actions.FavoriteAction"/>
            <action id="CodeEpiphany.Actions.LeetCode.Category"
                    class="com.wenjunhuang.codeepiphany.presentation.actions.CategoryAction"/>
            <action id="CodeEpiphany.Actions.LeetCode.Company"
                    class="com.wenjunhuang.codeepiphany.presentation.actions.CompanyAction"/>
            <action id="CodeEpiphany.Actions.LeetCode.Position"
                    class="com.wenjunhuang.codeepiphany.presentation.actions.PositionAction"/>
            <action id="CodeEpiphany.Actions.LeetCode.InterviewPeriod"
                    class="com.wenjunhuang.codeepiphany.presentation.actions.InterviewPeriodAction"/>
        </group>

        <group id="CodeEpiphany.Editor.Group">
            <reference ref="CodeEpiphany.Actions.EditTestCases"/>
            <reference ref="CodeEpiphany.Actions.RunTest"/>
            <reference ref="CodeEpiphany.Actions.SubmitCode"/>
            <reference ref="CodeEpiphany.Actions.SurroundSubmissionRegion"/>
            <reference ref="CodeEpiphany.Actions.SolutionSelection"/>
            <reference ref="CodeEpiphany.Actions.ActivateSolutionsView"/>
            <reference ref="CodeEpiphany.Actions.ActivateNotesView"/>
            <reference ref="CodeEpiphany.Actions.ActivateDescriptionView"/>
            <reference ref="CodeEpiphany.Actions.ActivateSubmissionsView"/>
        </group>

        <group id="CodeEpiphany.ChallengeEditor.Toolbar.Group">
            <reference ref="CodeEpiphany.Actions.EditTestCases"/>
            <reference ref="CodeEpiphany.Actions.RunTest"/>
            <reference ref="CodeEpiphany.Actions.SubmitCode"/>
            <reference ref="CodeEpiphany.Actions.SurroundSubmissionRegion"/>
            <reference ref="CodeEpiphany.Actions.SolutionSelection"/>
            <reference ref="CodeEpiphany.Actions.ActivateSolutionsView"/>
            <reference ref="CodeEpiphany.Actions.ActivateNotesView"/>
            <reference ref="CodeEpiphany.Actions.ActivateDescriptionView"/>
            <reference ref="CodeEpiphany.Actions.ActivateSubmissionsView"/>
        </group>

        <group id="CodeEpiphany.Editor.Menu" class="com.wenjunhuang.codeepiphany.presentation.editor.EditorMenuActionGroup"
               popup="true">
            <reference ref="CodeEpiphany.Editor.Group"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </group>



        <group id="CodeEpiphany.Dojos.LeetCode.Toolbar">
            <reference ref="CodeEpiphany.Actions.LeetCode.Category"/>
            <reference ref="CodeEpiphany.Actions.LeetCode.Favorite"/>
            <reference ref="CodeEpiphany.Actions.LeetCode.Company"/>
            <reference ref="CodeEpiphany.Actions.LeetCode.Position"/>
            <reference ref="CodeEpiphany.Actions.Difficulty"/>
            <reference ref="CodeEpiphany.Actions.Status"/>
            <reference ref="CodeEpiphany.Actions.Tags"/>
            <reference ref="CodeEpiphany.Actions.LeetCode.InterviewPeriod"/>
            <reference ref="CodeEpiphany.Actions.Refresh"/>
        </group>


        <group id="CodeEpiphany.Dojos.TitleToolbar.Account" popup="true"
               class="com.wenjunhuang.codeepiphany.presentation.actions.AccountGroup">
            <action id="CodeEpiphany.Actions.UserAccountInfo"
                    class="com.wenjunhuang.codeepiphany.presentation.actions.UserInfoAction"/>
            <reference ref="CodeEpiphany.Actions.Logout"/>
        </group>
        <group id="CodeEpiphany.Dojos.TitleToolbar">
            <reference ref="CodeEpiphany.Actions.Login"/>
            <reference ref="CodeEpiphany.Dojos.TitleToolbar.Account"/>
        </group>

        <!-- 题库面板迁入底部工具窗口后，站点相关动作改挂在面板工具栏上 -->
        <group id="CodeEpiphany.Dojos.LeetCode.SiteActions">
            <reference ref="CodeEpiphany.Actions.LeetCode.ChangeUI"/>
            <reference ref="CodeEpiphany.Actions.Login"/>
            <reference ref="CodeEpiphany.Dojos.TitleToolbar.Account"/>
        </group>

        <group id="CodeEpiphany.Dojos.ChallengesTable.Popupmenu">
            <reference ref="CodeEpiphany.Dojos.Actions.OpenChallengeGroup"/>
        </group>

        <group id="CodeEpiphany.Sidebar">
            <action id="CodeEpiphany.Actions.Webview.ZoomIn"
                    class="com.wenjunhuang.codeepiphany.presentation.sidebar.ZoomInAction"
                    icon="AllIcons.General.ZoomIn"/>
            <action id="CodeEpiphany.Actions.Webview.ZoomOut"
                    class="com.wenjunhuang.codeepiphany.presentation.sidebar.ZoomOutAction"
                    icon="AllIcons.General.ZoomOut"/>
            <action id="CodeEpiphany.Actions.Webview.ActualZoom"
                    class="com.wenjunhuang.codeepiphany.presentation.sidebar.ActualZoomAction"
                    icon="AllIcons.General.ActualZoom"/>
        </group>

        <group id="CodeEpiphany.Sidebar.Webview.Toolbar">
            <reference ref="CodeEpiphany.Actions.Webview.ZoomIn"/>
            <reference ref="CodeEpiphany.Actions.Webview.ZoomOut"/>
            <reference ref="CodeEpiphany.Actions.Webview.ActualZoom"/>
        </group>
        <group id="CodeEpiphany.Sidebar.Webview.PopupMenu">
            <reference ref="$Copy"/>
            <separator/>
            <reference ref="FindUsages"/>
            <separator/>
            <reference ref="CodeEpiphany.Sidebar.Webview.Toolbar"/>
        </group>

        <group id="CodeEpiphany.Sidebar.SubmissionLog.Toolbar.Group">
            <action class="com.wenjunhuang.codeepiphany.presentation.actions.DojoAction"
                    id="CodeEpiphany.Sidebar.SubmissionLog.Actions.CodeDojo"/>
            <action class="com.wenjunhuang.codeepiphany.presentation.actions.LanguageAction"
                    id="CodeEpiphany.Sidebar.SubmissionLog.Actions.Language"/>
            <reference ref="CodeEpiphany.Actions.Refresh"/>
        </group>

        <group id="CodeEpiphany.Sidebar.SubmissionsTable.Popupmenu">
            <reference ref="CodeEpiphany.Actions.OpenSubmissionCode"/>
            <reference ref="CompareTwoFiles"/>
            <reference ref="CompareFileWithEditor"/>
        </group>

        <group id="CodeEpiphany.Sidebar.LeetCodeArticles.Toolbar.Group">
            <reference ref="CodeEpiphany.Actions.Tags"/>
            <action id="CodeEpiphany.Sidebar.Solutions.Actions.LeetCodeArticlesOrderBy"
                    class="com.wenjunhuang.codeepiphany.presentation.sidebar.ArticleOrderAction"/>
        </group>


    </actions>


    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup displayType="STICKY_BALLOON" id="Code Epiphany" isLogByDefault="true"/>
        <postStartupActivity implementation="com.wenjunhuang.codeepiphany.activities.CodeEpiphanyStartupActivity"/>
        <toolWindow factoryClass="com.wenjunhuang.codeepiphany.presentation.sidebar.SidebarWindowFactory"
                    id="leetcode-editor"
                    secondary="false"
                    anchor="bottom"
                    icon="CodeEpiphanyIcons.PLUGIN"/>

        <registryKey defaultValue="false" description="Enable debug" key="codeepiphany.debug"/>

        <projectConfigurable parentId="tools"
                             displayName="leetcode-editor"
                             id="CodeEpiphany.Settings"
                             instance="com.wenjunhuang.codeepiphany.settings.CodeEpiphanySettingsConfigurable">
            <configurable id="CodeEpiphany.Settings.LeetCodeCN"
                          instance="com.wenjunhuang.codeepiphany.leetcode.settings.LeetCodeCNSettingsConfigurable"
                          key="leetcodecn.settings.displayName"/>
            <configurable id="CodeEpiphany.Settings.LeetCode"
                          instance="com.wenjunhuang.codeepiphany.leetcode.settings.LeetCodeSettingsConfigurable"
                          key="leetcode.settings.displayName"/>
        </projectConfigurable>

        <lang.foldingBuilder language="JAVA"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="Kotlin"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="Scala"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="Dart"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="Haskell"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="Python"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="JavaScript"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="TypeScript"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="ObjectiveC"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="C++"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="C"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="C#"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="Rust"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="go"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="Python"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>
        <lang.foldingBuilder language="PHP"
                             implementationClass="com.wenjunhuang.codeepiphany.editor.extensions.SubmissionRegionFoldingBuilder"/>


        <fileIconPatcher implementation="com.wenjunhuang.codeepiphany.presentation.editor.ChallengeEditorIconProvider"
                         order="last"/>
        <editorTabTitleProvider
                implementation="com.wenjunhuang.codeepiphany.presentation.editor.ChallengeEditorTabTitleProvider"
                order="last"/>
        <fileEditorProvider
                id="CodeEpiphany.EditorProvider"
                implementation="com.wenjunhuang.codeepiphany.presentation.editor.ChallengeEditorProvider"/>
        <fileEditorProvider
                id="CodeEpiphany.WebPreviewEditorProvider"
                implementation="com.wenjunhuang.codeepiphany.presentation.browser.PreviewEditorProvider"/>

        <fileEditorProvider id="CodeEpiphany.SubmissionCodeEditorProvider"
                            implementation="com.wenjunhuang.codeepiphany.presentation.files.CodeEditorProvider"/>
        <vfs.asyncListener implementation="com.wenjunhuang.codeepiphany.presentation.editor.ChallengeFileRenameListener"/>
        <virtualFileSystem key="submission-code"
                           physical="false"
                           implementationClass="com.wenjunhuang.codeepiphany.presentation.files.CodeFileSystem"/>
        <virtualFileSystem key="solution-remark"
                           physical="false"
                           implementationClass="com.wenjunhuang.codeepiphany.presentation.files.NoteFileSystem"/>

    </extensions>
</idea-plugin>
